<%- include('partials/header') %>
<section class="container page-pad">
  <h1>Find a lawyer</h1>
  <div class="search-layout">
    <form class="card filters" method="get" action="/lawyers">
      <label>Keywords <input name="q" value="<%= f.q %>" placeholder="Name, firm, keyword"></label>
      <label>Practice area
        <select name="area"><option value="">Any</option>
          <% areas.forEach(a => { %><option value="<%= a.slug %>" <%= f.area === a.slug ? 'selected' : '' %>><%= a.name %></option><% }) %>
        </select>
      </label>
      <label>City <input name="city" value="<%= f.city %>"></label>
      <label>State
        <select name="state"><option value="">Any</option>
          <% states.forEach(s => { %><option <%= f.state.toUpperCase() === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </label>
      <label>Language
        <select name="language"><option value="">Any</option>
          <% languages.forEach(s => { %><option <%= f.language === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </label>
      <label class="check"><input type="checkbox" name="free" value="1" <%= f.freeConsult ? 'checked' : '' %>> Free consultation</label>
      <label>Sort by
        <select name="sort">
          <% [['relevance','Best match'],['experience','Most experience'],['name','Name'],['newest','Newest']].forEach(([v, t]) => { %>
            <option value="<%= v %>" <%= f.sort === v ? 'selected' : '' %>><%= t %></option><% }) %>
        </select>
      </label>
      <button class="btn btn-primary btn-block">Apply filters</button>
      <a class="small" href="/lawyers">Clear all</a>
    </form>

    <div>
      <div class="result-head">
        <p class="muted"><%= total %> lawyer<%= total === 1 ? '' : 's' %> found</p>
        <a class="btn btn-accent btn-sm" href="/assistant">✦ Ask the AI to match me</a>
      </div>
      <% if (!rows.length) { %>
        <div class="card empty">
          <p>No lawyers match these filters yet.</p>
          <p class="small muted">Try removing a filter, or <a href="/assistant">describe your matter to our AI assistant</a>.</p>
        </div>
      <% } %>
      <div class="card-grid two"><% rows.forEach(l => { %><%- include('partials/lawyer-card', { l }) %><% }) %></div>
      <% if (pages > 1) { %>
        <nav class="pager">
          <% for (let p = 1; p <= pages; p++) { %><a class="<%= p === f.page ? 'current' : '' %>" href="<%= qs({ page: p }) %>"><%= p %></a><% } %>
        </nav>
      <% } %>
    </div>

    <div class="sidebar"><%- include('partials/ad', { ad }) %></div>
  </div>
</section>
<%- include('partials/footer') %>
