<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <h1>Inquiries</h1>
    <p class="muted small">Messages visitors sent to lawyers (latest 200).</p>
    <div class="card table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>To</th><th>From</th><th>Source</th><th>Message</th></tr></thead>
        <tbody>
        <% rows.forEach(i => { %>
          <tr><td class="tiny nowrap"><%= i.created_at %></td><td class="small"><a href="/lawyers/<%= i.slug %>"><%= i.lawyer_name %></a></td>
          <td class="small"><%= i.name %><div class="tiny muted"><%= i.email %></div></td><td class="tiny"><%= i.source === 'assistant' ? 'AI match' : 'Profile' %></td>
          <td class="small"><%= i.message.slice(0, 140) %><%= i.message.length > 140 ? '…' : '' %></td></tr>
        <% }) %>
        </tbody>
      </table>
      <% if (!rows.length) { %><p class="muted">No inquiries yet.</p><% } %>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
