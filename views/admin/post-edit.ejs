<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <div class="section-head"><h1><%= title %></h1><% if (post.id) { %><a class="btn btn-ghost btn-sm" href="/blog/<%= post.slug %>" target="_blank">Preview ↗</a><% } %></div>
    <form method="post" action="/admin/posts/<%= post.id || 'new' %>" enctype="multipart/form-data" class="card form-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="span-2">Title* <input name="title" required value="<%= post.title || '' %>"></label>
      <label>URL slug <input name="slug" value="<%= post.slug || '' %>" placeholder="auto from title"></label>
      <label>Author <input name="author" value="<%= post.author || '' %>"></label>
      <label class="span-2">Excerpt <textarea name="excerpt" rows="2"><%= post.excerpt || '' %></textarea></label>
      <div class="span-2">
        <span class="field-label">Body</span>
        <div class="rte" id="rte">
          <div class="rte-toolbar" role="toolbar" aria-label="Formatting">
            <button type="button" data-cmd="formatBlock" data-arg="H2" title="Heading">H2</button>
            <button type="button" data-cmd="formatBlock" data-arg="H3" title="Subheading">H3</button>
            <button type="button" data-cmd="formatBlock" data-arg="P" title="Normal text">¶</button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="bold" title="Bold (Ctrl+B)"><b>B</b></button>
            <button type="button" data-cmd="italic" title="Italic (Ctrl+I)"><i>I</i></button>
            <button type="button" data-cmd="underline" title="Underline (Ctrl+U)"><u>U</u></button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="insertUnorderedList" title="Bullet list">• List</button>
            <button type="button" data-cmd="insertOrderedList" title="Numbered list">1. List</button>
            <button type="button" data-cmd="formatBlock" data-arg="BLOCKQUOTE" title="Quote">❝</button>
            <span class="rte-sep"></span>
            <button type="button" data-cmd="link" title="Add link">🔗 Link</button>
            <button type="button" data-cmd="unlink" title="Remove link">Unlink</button>
            <button type="button" data-cmd="image" title="Insert image">🖼 Image</button>
            <button type="button" data-cmd="removeFormat" title="Clear formatting">Clear</button>
          </div>
          <div class="rte-area prose" id="rte-area" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Post body"><%- bodyHtml %></div>
          <input type="file" id="rte-image" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
        </div>
        <textarea name="body" id="rte-body" hidden></textarea>
      </div>
      <div class="span-2">
        <% if (post.cover_image) { %><img src="<%= post.cover_image %>" alt="" class="thumb"> <label class="check"><input type="checkbox" name="remove_cover"> Remove cover</label><% } %>
        <label>Cover image <input type="file" name="cover_image" accept="image/*"></label>
      </div>
      <label>Status <select name="status"><option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>Draft</option><option value="published" <%= post.status === 'published' ? 'selected' : '' %>>Published</option></select></label>
      <span></span>
      <button class="btn btn-primary span-2">Save post</button>
    </form>
    <% if (post.id) { %><form method="post" action="/admin/posts/<%= post.id %>/delete" class="danger-zone" data-confirm="Delete this post?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">Delete post</button></form><% } %>
  </div>
</section>
<%- include('../partials/footer') %>
