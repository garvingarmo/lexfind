<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <h1>Referrals</h1>
    <p class="muted small">Clients members referred to other lawyers (latest 300). "Emailed" shows whether the lawyer was sent the referral by email.</p>
    <div class="card table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Referred by</th><th>Referred to</th><th>Client</th><th>Matter</th><th>Emailed</th></tr></thead>
        <tbody>
        <% rows.forEach(r => { %>
          <tr><td class="tiny nowrap"><%= r.created_at %></td>
          <td class="small"><% if (r.from_slug) { %><a href="/lawyers/<%= r.from_slug %>"><%= r.from_name %></a><% } else { %><%= r.from_name %><% } %><div class="tiny muted"><%= r.from_email %></div></td>
          <td class="small"><a href="/lawyers/<%= r.to_slug %>"><%= r.to_name %></a></td>
          <td class="small"><%= r.client_name %><div class="tiny muted"><%= r.client_email %> · <%= r.client_phone %></div></td>
          <td class="small"><%= (r.matter || '').slice(0, 140) %><%= (r.matter || '').length > 140 ? '…' : '' %></td>
          <td class="tiny"><%= r.emailed ? 'Yes' : 'No' %></td></tr>
        <% }) %>
        </tbody>
      </table>
      <% if (!rows.length) { %><p class="muted">No referrals yet.</p><% } %>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
