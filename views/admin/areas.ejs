<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <h1>Practice areas</h1>
    <p class="muted small">Visitors only see areas with at least one active lawyer. The AI assistant uses these names and descriptions to match visitors to lawyers, so keep the list tidy and descriptions specific.</p>

    <div class="card">
      <h2>Tidy up</h2>
      <p class="small"><strong><%= rows.length %></strong> practice areas, <strong><%= rows.filter(a => a.total_count === 0).length %></strong> with no lawyers.</p>
      <ul class="small">
        <li><strong>Merge</strong> duplicates (e.g. "Business" into "Business Law"): the lawyers move to the area you pick and the duplicate is deleted.</li>
        <li><strong>Rename</strong> by editing the name and clicking Save.</li>
      </ul>
      <form method="post" action="/admin/areas/delete-unused" data-confirm="Delete every practice area that has no lawyers?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-outline btn-sm" <%= rows.some(a => a.total_count === 0) ? '' : 'disabled' %>>Delete areas with no lawyers</button>
      </form>
    </div>

    <form method="post" action="/admin/areas" class="card form-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>New area name <input name="name" required></label>
      <label>Description <input name="description"></label>
      <button class="btn btn-primary span-2">Add practice area</button>
    </form>

    <div class="card">
    <% rows.forEach(a => { %>
      <div class="area-row <%= a.total_count === 0 ? 'dim' : '' %>">
        <form method="post" action="/admin/areas" class="area-edit">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= a.id %>">
          <input name="name" value="<%= a.name %>" aria-label="Name">
          <input name="description" value="<%= a.description || '' %>" placeholder="Description (helps the AI assistant)" aria-label="Description">
          <span class="tiny muted nowrap" title="Active lawyers / all lawyers"><%= a.lawyer_count %> active<%= a.total_count !== a.lawyer_count ? ` / ${a.total_count}` : '' %></span>
          <button class="btn btn-outline btn-sm">Save</button>
        </form>
        <form method="post" action="/admin/areas/<%= a.id %>/merge" class="area-merge" data-confirm="Merge <%= a.name %> into the selected area? <%= a.name %> will be deleted.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <select name="into" aria-label="Merge <%= a.name %> into" required>
            <option value="">Merge into…</option>
            <% rows.forEach(b => { if (b.id !== a.id) { %><option value="<%= b.id %>"><%= b.name %></option><% } }) %>
          </select>
          <button class="btn btn-ghost btn-sm">Merge</button>
        </form>
        <form method="post" action="/admin/areas/<%= a.id %>/delete" data-confirm="Delete <%= a.name %>? Lawyers will be unlinked from it.">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Delete</button>
        </form>
      </div>
    <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
