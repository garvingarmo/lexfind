<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <h1>Practice areas</h1>
    <p class="muted small">Group areas into main categories with sub-categories (e.g. <em>Family Law</em> → <em>Divorce</em>, <em>Child Custody</em>) by dragging them in the list below. Searching a main category also finds lawyers in its sub-categories. Visitors only see areas with at least one active lawyer. The AI assistant uses these names and descriptions to match visitors to lawyers, so keep the list tidy and descriptions specific.</p>

    <div class="card">
      <h2>Tidy up</h2>
      <p class="small"><strong><%= rows.length %></strong> practice areas, <strong><%= rows.filter(a => a.depth === 0).length %></strong> main categories, <strong><%= rows.filter(a => a.total_count === 0 && !a.children.length).length %></strong> with no lawyers.</p>
      <ul class="small">
        <li><strong>Merge</strong> duplicates (e.g. "Business" into "Business Law"): the lawyers move to the area you pick and the duplicate is deleted.</li>
        <li><strong>Rename</strong> by editing the name and clicking Save.</li>
        <li><strong>Organise</strong> by dragging areas in the list below.</li>
        <li>In an import sheet, write <em>Family Law &gt; Divorce</em> to put a lawyer in a sub-category (both are created if needed).</li>
      </ul>
      <form method="post" action="/admin/areas/delete-unused" data-confirm="Delete every practice area that has no lawyers?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-outline btn-sm" <%= rows.some(a => a.total_count === 0 && !a.children.length) ? '' : 'disabled' %>>Delete areas with no lawyers</button>
      </form>
    </div>

    <form method="post" action="/admin/areas" class="card form-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>New area name <input name="name" required></label>
      <label>Description <input name="description"></label>
      <label>Sub-category of
        <select name="parent_id"><option value="">— Main category —</option>
          <% mains.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
        </select>
      </label>
      <button class="btn btn-primary span-2">Add practice area</button>
    </form>

    <div class="card">
      <div class="section-head"><h2>Organise</h2><span class="tiny muted" id="area-order-status" role="status" aria-live="polite"></span></div>
      <p class="small muted">Drag <span class="drag-handle-demo">⠿</span> to reorder. Drop an area onto the indented space under a main category to make it a sub-category; drag it back out to make it a main category. Changes save automatically, and the order is used in the site's menus.</p>
      <%
        const row = (a) => { %>
        <div class="area-row <%= a.total_count === 0 && !a.children.length ? 'dim' : '' %>">
          <span class="drag-handle" title="Drag to move" aria-hidden="true">⠿</span>
          <form method="post" action="/admin/areas" class="area-edit">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= a.id %>">
            <input name="name" value="<%= a.name %>" aria-label="Name">
            <input name="description" value="<%= a.description || '' %>" placeholder="Description (helps the AI assistant)" aria-label="Description">
            <span class="tiny muted nowrap area-count" title="Active lawyers / all lawyers"><%= a.lawyer_count %> active<%= a.total_count !== a.lawyer_count ? ` / ${a.total_count}` : '' %><%= a.children.length ? ` · ${a.group_count} incl. sub` : '' %></span>
            <button class="btn btn-outline btn-sm">Save</button>
          </form>
          <form method="post" action="/admin/areas/<%= a.id %>/merge" class="area-merge" data-confirm="Merge <%= a.name %> into the selected area? <%= a.name %> will be deleted.">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <select name="into" aria-label="Merge <%= a.name %> into" required>
              <option value="">Merge into…</option>
              <% rows.forEach(b => { if (b.id !== a.id) { %><option value="<%= b.id %>"><%= b.label %></option><% } }) %>
            </select>
            <button class="btn btn-ghost btn-sm">Merge</button>
          </form>
          <form method="post" action="/admin/areas/<%= a.id %>/delete" data-confirm="Delete <%= a.name %>? Lawyers will be unlinked from it.">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Delete</button>
          </form>
        </div>
      <% } %>
      <ul class="area-tree" id="area-tree" data-save="/admin/areas/order.json">
        <% rows.filter(a => a.depth === 0).forEach(m => { %>
          <li class="area-node" data-id="<%= m.id %>">
            <% row(m) %>
            <ul class="area-tree-subs" data-parent="<%= m.id %>">
              <% rows.filter(a => a.depth === 1 && a.parent_id === m.id).forEach(c => { %>
                <li class="area-node" data-id="<%= c.id %>"><% row(c) %></li>
              <% }) %>
            </ul>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
<script src="/vendor/sortable.min.js" defer></script>
<%- include('../partials/footer') %>
