<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <h1>Integrations</h1>

    <div class="card stack">
      <div class="section-head"><h2>Claude AI</h2><span class="status status-<%= ai.on ? 'active' : 'draft' %>"><%= ai.on ? 'On' : 'Off' %></span></div>
      <p class="small muted">Powers the AI lawyer-match assistant and AI profile research. Get a key at <a href="https://console.anthropic.com/settings/keys" target="_blank" rel="noopener">console.anthropic.com → API Keys</a> (add some credit under Billing first).</p>
      <% if (ai.fromEnv) { %>
        <p class="small">The key is set by the server's <code>ANTHROPIC_API_KEY</code> setting (<%= ai.masked %>), which takes priority over this page.</p>
      <% } else { %>
        <form method="post" action="/admin/integrations/ai" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Anthropic API key <% if (ai.masked) { %><span class="tiny muted">(saved: <%= ai.masked %>; paste a new one to replace it)</span><% } %>
            <input name="api_key" type="password" autocomplete="off" placeholder="sk-ant-…">
          </label>
          <div class="actions start">
            <button class="btn btn-primary btn-sm">Save key</button>
            <% if (ai.masked) { %><button class="btn btn-ghost btn-sm" name="remove" value="1" data-confirm="Remove the API key? AI features will switch off.">Remove key</button><% } %>
          </div>
        </form>
      <% } %>
      <form method="post" action="/admin/integrations/ai/test"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm" <%= ai.on ? '' : 'disabled' %>>Test connection</button> <span class="tiny muted">Model: <%= ai.model %></span></form>
    </div>

    <div class="card stack">
      <div class="section-head"><h2>Email</h2><span class="status status-<%= mail.on ? 'active' : 'draft' %>"><%= mail.on ? 'On' : 'Off' %></span></div>
      <% if (!mail.on && missing.length) { %><p class="flash flash-info small">Email is off because these are missing: <strong><%= missing.join(', ') %></strong>.</p><% } %>
      <p class="small muted">Used for "Forgot password", lawyer invitations, contact-form notifications and "Email results". A sending service such as Resend or Brevo is the most reliable way to reach Gmail and Outlook inboxes.</p>
      <% if (mail.fromEnv) { %>
        <p class="small">Email is set by the server's <code>MAIL_*</code> / <code>SMTP_*</code> settings, which take priority over this page.</p>
      <% } else { %>
        <form method="post" action="/admin/integrations/mail" class="form-grid">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="span-2">Send email using
            <select name="mail_provider" data-show-group="mail-provider">
              <% for (const [value, label] of Object.entries(PROVIDERS)) { %><option value="<%= value %>" <%= mail.provider === value ? 'selected' : '' %>><%= label %></option><% } %>
            </select>
          </label>

          <div class="span-2 form-grid" data-group="mail-provider" data-show-for="resend brevo sendgrid" <%= ['resend', 'brevo', 'sendgrid'].includes(mail.provider) ? '' : 'hidden' %>>
            <p class="span-2 small muted" data-show-for-provider="resend">Sign up at <a href="https://resend.com" target="_blank" rel="noopener">resend.com</a>, add your domain under <strong>Domains</strong> and copy its DNS records to your domain's DNS. Then create a key under <strong>API Keys</strong> (permission "Sending access") and paste it below.</p>
            <p class="span-2 small muted" data-show-for-provider="brevo">Sign up at <a href="https://www.brevo.com" target="_blank" rel="noopener">brevo.com</a>, authenticate your domain under <strong>Senders, Domains &amp; Dedicated IPs → Domains</strong> and copy its DNS records to your domain's DNS. Then create a key under <strong>SMTP &amp; API → API Keys</strong> and paste it below.</p>
            <p class="span-2 small muted" data-show-for-provider="sendgrid">Sign up at <a href="https://sendgrid.com" target="_blank" rel="noopener">sendgrid.com</a>, go to <strong>Settings → Sender Authentication → Authenticate Your Domain</strong> and copy its DNS records to your domain's DNS. Then create a key under <strong>Settings → API Keys</strong> ("Restricted Access" with <strong>Mail Send</strong> on) and paste it below.</p>
            <label class="span-2">API key <% if (mail.keyMasked) { %><span class="tiny muted">(saved: <%= mail.keyMasked %>; paste a new one to replace it)</span><% } %>
              <input name="mail_api_key" type="password" autocomplete="off" placeholder="Paste the key from the sending service">
            </label>
          </div>

          <div class="span-2 form-grid" data-group="mail-provider" data-show-for="gmail" <%= mail.provider === 'gmail' ? '' : 'hidden' %>>
            <div class="span-2 small muted">
              <p>Sends through Google's mail servers, so messages reach Gmail and Outlook inboxes reliably. Gmail allows about 500 emails a day (2,000 with Google Workspace).</p>
              <ol>
                <li>Sign in to the Gmail account at <a href="https://myaccount.google.com/security" target="_blank" rel="noopener">myaccount.google.com/security</a> and turn on <strong>2-Step Verification</strong> if it isn't on.</li>
                <li>Open <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener">myaccount.google.com/apppasswords</a>, type a name such as <em>Chaldean Law website</em>, and click <strong>Create</strong>.</li>
                <li>Copy the 16-letter password Google shows and paste it below. (Not your normal Gmail password.)</li>
              </ol>
            </div>
            <label>Gmail address <input name="gmail_user" type="email" value="<%= gmail.user %>" placeholder="e.g. yourname@gmail.com" autocomplete="off"></label>
            <label>App password <% if (gmail.passMasked) { %><span class="tiny muted">(saved; leave blank to keep)</span><% } %><input name="gmail_pass" type="password" autocomplete="new-password" placeholder="abcd efgh ijkl mnop"></label>
            <p class="span-2 tiny muted">Emails are sent from this Gmail address; Gmail replaces any other "send as" address unless it's added in Gmail under Settings → Accounts → <em>Send mail as</em>. Replies from site emails (inquiries, referrals) still go to the right person.</p>
          </div>

          <div class="span-2 form-grid" data-group="mail-provider" data-show-for="smtp" <%= mail.provider === 'smtp' ? '' : 'hidden' %>>
            <p class="span-2 small muted">Use the details of a mailbox from cPanel → Email Accounts.</p>
            <label>Mail server (SMTP host) <input name="smtp_host" value="<%= mail.host %>" placeholder="e.g. mail.yourdomain.com"></label>
            <label>Port <input name="smtp_port" type="number" value="<%= mail.port %>"></label>
            <label>Username <input name="smtp_user" value="<%= mail.user || (mail.host ? '' : suggest.user) %>" placeholder="e.g. noreply@yourdomain.com" autocomplete="off"></label>
            <label>Password <% if (mail.passMasked) { %><span class="tiny muted">(saved; leave blank to keep)</span><% } %><input name="smtp_pass" type="password" autocomplete="new-password"></label>
          </div>

          <label class="span-2">Send emails as <input name="mail_from" value="<%= mail.from || suggest.from %>" placeholder="e.g. Your Site <noreply@yourdomain.com>" required>
            <span class="tiny muted">Must be an address at a domain you have verified with the sending service.</span>
          </label>
          <div class="actions start span-2">
            <button class="btn btn-primary btn-sm">Save email settings</button>
            <% if (mail.on) { %><button class="btn btn-ghost btn-sm" name="remove" value="1" data-confirm="Remove the email settings?">Remove</button><% } %>
          </div>
        </form>
      <% } %>
      <form method="post" action="/admin/integrations/mail/test"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="tiny" for="test-to">Send a test email to</label> <input id="test-to" type="email" name="to" value="<%= user.email %>" required> <button class="btn btn-outline btn-sm" <%= mail.on ? '' : 'disabled' %>>Send test email</button></form>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
