<%- include('../partials/header') %>
<section class="container page-pad backoffice">
  <%- include('../partials/side-nav') %>
  <div>
    <div class="section-head">
      <h1><%= title %></h1>
      <% if (l.id) { %><div><a class="btn btn-ghost btn-sm" href="/lawyers/<%= l.slug %>" target="_blank">View ↗</a> <a class="btn btn-accent btn-sm" href="/admin/lawyers/<%= l.id %>/research">✦ AI research</a></div><% } %>
    </div>
    <% if (locals.duplicates && duplicates.length) { %>
      <div class="flash flash-error dup-banner">
        <strong>Possible duplicate.</strong> This listing looks like:
        <ul>
          <% duplicates.forEach(m => { %>
            <li><a href="/admin/lawyers/<%= m.lawyer.id %>"><%= m.lawyer.name %></a><span class="small"><%= m.lawyer.firm ? ', ' + m.lawyer.firm : '' %><%= m.lawyer.city ? ', ' + m.lawyer.city : '' %> — <%= m.strength === 'definite' ? 'very likely the same lawyer' : 'possibly the same lawyer' %> (<%= m.reasons.join(', ') %>)</span>
              <a class="btn btn-outline btn-sm" href="/admin/merge?a=<%= l.id %>&b=<%= m.lawyer.id %>">Compare &amp; merge</a>
              <form method="post" action="/admin/duplicates/dismiss" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="a" value="<%= l.id %>"><input type="hidden" name="b" value="<%= m.lawyer.id %>"><input type="hidden" name="back" value="lawyer"><button class="btn btn-ghost btn-sm">Not a duplicate</button></form>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    <form method="post" action="/admin/lawyers/<%= l.id || 'new' %>" enctype="multipart/form-data" class="card form-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <fieldset class="span-2 admin-box"><legend>Listing controls</legend>
        <div class="form-grid">
          <label>Status <select name="status"><% ['pending','active','suspended'].forEach(s => { %><option <%= l.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></label>
          <% if (l.id) { %><label>URL slug <input name="slug" value="<%= l.slug %>"></label><% } else { %><span></span><% } %>
          <label class="check"><input type="checkbox" name="featured" <%= l.featured ? 'checked' : '' %>> Sponsored / featured (shown first in search)</label>
          <label class="check"><input type="checkbox" name="verified" <%= l.verified ? 'checked' : '' %>> Verified (bar status checked)</label>
          <label class="check"><input type="checkbox" name="hidden" <%= l.hidden ? 'checked' : '' %>> Hide from directory <span class="tiny muted">(not shown in search, profiles, the AI match or exports; the lawyer keeps their login and membership)</span></label>
          <label>Login email <input name="login_email" type="email" value="<%= login ? login.email : '' %>" placeholder="Lets the lawyer sign in"></label>
          <label><%= login ? 'Reset password' : 'Login password' %> <input name="login_password" type="password" minlength="8" autocomplete="new-password" placeholder="<%= login ? 'Leave blank to keep' : 'Min 8 characters' %>"></label>
        </div>
      </fieldset>
      <%- include('../partials/profile-fields', { l, areas, selected }) %>
      <button class="btn btn-primary span-2">Save</button>
    </form>
    <% if (l.id) { %>
      <div class="card" id="invite">
        <h2>Lawyer login</h2>
        <% if (login) { %>
          <p class="small">This listing has been claimed. <%= l.name %> signs in as <strong><%= login.email %></strong>.</p>
          <form method="post" action="/admin/lawyers/<%= l.id %>/unclaim" data-confirm="Remove the login <%= login.email %> from this listing? They will be signed out and can no longer manage it. The listing and its details stay as they are.">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-outline btn-sm">Remove login (unclaim listing)</button>
            <span class="tiny muted">Use this if the wrong person claimed it, or to hand the listing to someone else.</span>
          </form>
        <% } else if (invite) { %>
          <p class="small">Invitation link, valid until <%= invite.expires_at.slice(0, 10) %><%= invite.sent_at ? ', emailed ' + invite.sent_at.slice(0, 10) : '' %>. Send it to <%= l.name %> so they can set a password and manage this listing.</p>
          <div class="copy-row"><input readonly value="<%= inviteLink %>" aria-label="Invitation link"><button type="button" class="btn btn-ghost btn-sm" data-copy>Copy</button></div>
          <div class="actions start">
            <% if (mailOn && invite.email) { %><form method="post" action="/admin/lawyers/<%= l.id %>/invite/send"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-accent btn-sm">Email it to <%= invite.email %></button></form><% } %>
            <% if (invite.email) { %><a class="btn btn-outline btn-sm" href="mailto:<%= invite.email %>?subject=<%= encodeURIComponent('Claim your listing on ' + settings.site_name) %>&body=<%= encodeURIComponent('Hello ' + l.name + ',\n\nYour profile is listed in the ' + settings.site_name + ' attorney directory. Use this personal link to set up your login and manage your listing:\n\n' + inviteLink + '\n\nThe link works once and expires on ' + invite.expires_at.slice(0, 10) + '.') %>">Open in my email app</a><% } %>
            <form method="post" action="/admin/lawyers/<%= l.id %>/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Create a new link</button></form>
            <form method="post" action="/admin/lawyers/<%= l.id %>/invite/revoke" data-confirm="Cancel this invitation link?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Cancel link</button></form>
          </div>
        <% } else { %>
          <p class="small">No login yet. Create an invitation link so <%= l.name %> can set a password and manage this listing.</p>
          <form method="post" action="/admin/lawyers/<%= l.id %>/invite"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary btn-sm">Create invitation link</button></form>
        <% } %>
      </div>
      <form method="post" action="/admin/lawyers/<%= l.id %>/delete" class="danger-zone" data-confirm="Delete this lawyer and their login permanently?">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm">Delete lawyer</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
