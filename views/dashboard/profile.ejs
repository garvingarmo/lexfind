  <div class="card">
    <div class="section-head"><h1>Edit profile</h1><a class="btn btn-ghost btn-sm" href="/dashboard/research">✦ Fill in with AI</a></div>
    <form method="post" action="/dashboard/profile" enctype="multipart/form-data" class="form-grid">
