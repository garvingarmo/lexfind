<nav class="side-nav card">
<% if (user.role === 'admin') { %>
  <% [['/admin','Overview'],['/admin/lawyers','Lawyers'],['/admin/import','Import lawyers'],['/admin/invites','Invitations'],['/admin/areas','Practice areas'],['/admin/ads','Sponsored ads'],['/admin/posts','Blog'],['/admin/inquiries','Inquiries'],['/admin/settings','Site content'],['/admin/users','Admin users'],['/account/password','Password']].forEach(([h, t]) => { %>
    <a href="<%= h %>" class="<%= (path === h || (h !== '/admin' && path.startsWith(h))) ? 'active' : '' %>"><%= t %></a>
  <% }) %>
<% } else { %>
  <% [['/dashboard','Overview'],['/dashboard/profile','Edit profile'],['/dashboard/inquiries','Inquiries'],['/dashboard/research','AI profile update'],['/account/password','Password']].forEach(([h, t]) => { %>
    <a href="<%= h %>" class="<%= (path === h || (h !== '/dashboard' && path.startsWith(h))) ? 'active' : '' %>"><%= t %></a>
  <% }) %>
  <% if (myLawyer) { %><a href="/lawyers/<%= myLawyer.slug %>" target="_blank">View public profile ↗</a><% } %>
<% } %>
</nav>
