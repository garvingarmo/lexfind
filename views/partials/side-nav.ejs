<% } else { %>
  <% [['/dashboard','Overview'],['/dashboard/profile','Edit profile'],['/dashboard/inquiries','Inquiries'],['/dashboard/referrals','Referrals'],['/dashboard/research','AI profile update'],['/account/password','Password']].forEach(([h, t]) => { %>
