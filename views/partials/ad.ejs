<% if (ad) { %>
<aside class="ad ad-<%= ad.placement %>">
  <span class="ad-label">Sponsored</span>
  <% if (ad.image) { %><img src="<%= ad.image %>" alt=""><% } %>
  <div class="ad-body">
    <strong><%= ad.title %></strong>
    <% if (ad.body) { %><p><%= ad.body %></p><% } %>
    <a class="btn btn-primary btn-sm" href="/ad/<%= ad.id %>" rel="sponsored"><%= ad.cta || 'Learn more' %></a>
  </div>
</aside>
<% } %>
