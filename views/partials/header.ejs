<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? `${title} · ${settings.site_name}` : `${settings.site_name} — ${settings.tagline}` %></title>
<meta name="description" content="<%= settings.tagline %>">
<% const siteUrl = (settings.site_url || '').replace(/\/+$/, ''); if (siteUrl) { %>
<link rel="canonical" href="<%= siteUrl + path %>">
<meta property="og:url" content="<%= siteUrl + path %>">
<% } %>
<meta property="og:site_name" content="<%= settings.site_name %>">
<meta property="og:title" content="<%= title ? `${title} · ${settings.site_name}` : settings.site_name %>">
<meta property="og:description" content="<%= settings.tagline %>">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="<%= fontUrl %>" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
<link rel="stylesheet" href="/theme.css?v=<%= themeV %>">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="theme-color" content="<%= theme.theme_primary %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="<%= settings.site_name %>">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="csrf-token" content="<%= csrf %>">
</head>
<body class="<%= editMode ? 'edit-mode' : '' %>">
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/"><% if (theme.theme_logo) { %><img class="brand-logo" src="<%= theme.theme_logo %>" alt="<%= settings.site_name %>"><% if (theme.theme_logo_text === '1') { %><%= settings.site_name %><% } %><% } else { %><img class="brand-default" src="/brand/chaldeanlaw-logo-horizontal.svg" alt="<%= settings.site_name %>" width="1061" height="240"><% } %></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu">
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav-links">
      <% if (!locals.membersOnly || locals.isMember) { %>
      <a href="/lawyers" class="<%= path.startsWith('/lawyers') ? 'active' : '' %>"><%- e('nav.find') %></a>
      <a href="/assistant" class="<%= path === '/assistant' ? 'active' : '' %>"><%- e('nav.ai') %></a>
      <a href="/blog" class="<%= path.startsWith('/blog') ? 'active' : '' %>"><%- e('nav.guides') %></a>
      <% } %>
      <% if (user && user.role === 'admin') { %>
        <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a>
      <% } else if (user) { %>
        <a href="/dashboard">My listing</a>
      <% } %>
      <% if (user) { %>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Sign out</button></form>
      <% } else { %>
        <a href="/login"><%- e('nav.signin') %></a>
        <a class="btn btn-primary btn-sm" href="/register"><%- e('nav.list') %></a>
      <% } %>
    </nav>
  </div>
</header>
<main>
<% if (flash && flash.length) { %>
  <div class="container flashes">
    <% flash.forEach(f => { %><div class="flash flash-<%= f.type %>" role="status"><%= f.msg %></div><% }) %>
  </div>
<% } %>
