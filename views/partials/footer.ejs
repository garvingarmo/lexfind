</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/"><% if (theme.theme_logo) { %><img class="brand-logo" src="<%= theme.theme_logo %>" alt="<%= settings.site_name %>"><% if (theme.theme_logo_text === '1') { %><%= settings.site_name %><% } %><% } else { %><img class="brand-default" src="/brand/chaldeanlaw-logo-horizontal-reverse-transparent.svg" alt="<%= settings.site_name %>" width="1061" height="240"><% } %></a>
      <p class="muted small"><%- e('disclaimer') %></p>
      <% if (siteSocial.length) { %>
        <div class="social-links" aria-label="<%= t('footer.follow') %>">
          <% siteSocial.forEach(n => { %><a href="<%= n.url %>" target="_blank" rel="noopener" aria-label="<%= n.label %>" title="<%= n.label %>"><%- socialIcon(n.key) %></a><% }) %>
        </div>
      <% } %>
    </div>
    <% if (!locals.membersOnly || locals.isMember) { %>
    <div>
      <h4><%- e('footer.directory') %></h4>
      <a href="/lawyers"><%- e('footer.find') %></a>
      <a href="/assistant"><%- e('footer.ai') %></a>
      <a href="/blog"><%- e('footer.guides') %></a>
    </div>
    <% } %>
    <div>
      <h4><%- e('footer.forLawyers') %></h4>
      <a href="/register"><%- e('footer.list') %></a>
      <a href="/login"><%- e('footer.signin') %></a>
      <a href="/about"><%- e('footer.about') %></a>
    </div>
  </div>
  <div class="container small muted footer-bottom"><%- e('footer_text') %></div>
</footer>
<% if (settings.install_prompt !== '0' && !editMode && !path.startsWith('/admin')) { %>
<div class="install-banner" id="install-banner" role="dialog" aria-labelledby="install-title" hidden>
  <img src="/icons/icon-192.png" alt="" width="44" height="44">
  <div class="install-text">
    <strong id="install-title"><%- e('install.title') %></strong>
    <span class="small muted" data-install-text="prompt"><%- e('install.text') %></span>
    <span class="small muted" data-install-text="ios" hidden><%- e('install.ios') %></span>
    <span class="small muted" data-install-text="mac" hidden><%- e('install.mac') %></span>
  </div>
  <div class="install-actions">
    <button type="button" class="btn btn-primary btn-sm" data-install="go"><%- e('install.button') %></button>
    <button type="button" class="btn btn-ghost btn-sm" data-install="later"><%- e('install.later') %></button>
  </div>
</div>
<% } %>
<% if (user && user.role === 'admin' && !path.startsWith('/admin') && !path.startsWith('/dashboard')) { %>
<div class="edit-bar <%= editMode ? 'on' : '' %>" id="edit-bar">
  <% if (editMode) { %>
    <span><strong>Editing page.</strong> Click any outlined text to change it.</span>
    <span class="edit-count" id="edit-count"></span>
    <button type="button" class="btn btn-accent btn-sm" id="edit-save" disabled>Save changes</button>
    <form method="post" action="/admin/edit-mode" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= path %>"><button class="btn btn-ghost btn-sm">Done</button></form>
  <% } else { %>
    <form method="post" action="/admin/edit-mode" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="on" value="1"><input type="hidden" name="next" value="<%= path %>"><button class="btn btn-primary btn-sm">✎ Edit page</button></form>
  <% } %>
</div>
<% } %>
<script src="/js/app.js?v=<%= assetV %>" defer></script>
</body>
</html>
