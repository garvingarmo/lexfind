<label>Full name* <input name="name" required value="<%= l.name || '' %>"></label>
<label>Professional title <input name="title" value="<%= l.title || '' %>" placeholder="e.g. Partner, Attorney at Law"></label>
<label>Firm <input name="firm" value="<%= l.firm || '' %>"></label>
<label>Public email <input name="email" type="email" value="<%= l.email || '' %>"></label>
<label>Phone <input name="phone" value="<%= l.phone || '' %>"></label>
<label>Website <input name="website" value="<%= l.website || '' %>"></label>
<label class="span-2">Street address <input name="address" value="<%= l.address || '' %>"></label>
<label>City <input name="city" value="<%= l.city || '' %>"></label>
<div class="row-2">
  <label>State <input name="state" maxlength="2" value="<%= l.state || '' %>"></label>
  <label>ZIP <input name="zip" value="<%= l.zip || '' %>"></label>
</div>
<label>Bar number <input name="bar_number" value="<%= l.bar_number || '' %>"></label>
<label>Bar admissions <input name="bar_admissions" value="<%= l.bar_admissions || '' %>" placeholder="California (2009), Nevada (2012)"></label>
<label>Years of experience <input name="years_experience" type="number" min="0" max="80" value="<%= l.years_experience ?? '' %>"></label>
<% const myLangs = String(l.languages || '').split(/[,;/|\n]+/).map(s => s.trim()).filter(Boolean); const langList = [...languageOptions, ...myLangs.filter(x => !languageOptions.some(o => o.toLowerCase() === x.toLowerCase()))]; %>
<div class="field">
  <span class="field-label">Languages</span>
  <details class="multi-select" data-placeholder="Choose languages">
    <summary><%= myLangs.join(', ') || 'Choose languages' %></summary>
    <div class="ms-options">
      <input type="hidden" name="languages" value="">
      <% langList.forEach(lang => { %>
        <label class="check"><input type="checkbox" name="languages" value="<%= lang %>" <%= myLangs.some(x => x.toLowerCase() === lang.toLowerCase()) ? 'checked' : '' %>> <%= lang %></label>
      <% }) %>
    </div>
  </details>
</div>
<label class="span-2">Education <input name="education" value="<%= l.education || '' %>"></label>
<label>Fee structure <input name="fee_structure" value="<%= l.fee_structure || '' %>" placeholder="Hourly, flat fee, contingency…"></label>
<label>Hourly rate <input name="hourly_rate" value="<%= l.hourly_rate || '' %>" placeholder="$250–$350"></label>
<label class="check span-2"><input type="checkbox" name="free_consultation" <%= l.free_consultation ? 'checked' : '' %>> I offer a free initial consultation</label>
<label class="span-2">Bio <span class="tiny muted">(Markdown supported)</span><textarea name="bio" rows="8"><%= l.bio || '' %></textarea></label>
<fieldset class="span-2 social-fields"><legend>Social media <span class="tiny muted">(a full link or just the @username)</span></legend>
  <div class="form-grid">
    <% [['linkedin','LinkedIn','linkedin.com/in/your-name'],['facebook','Facebook','facebook.com/yourpage'],['instagram','Instagram','@yourname'],['x','X (Twitter)','@yourname'],['youtube','YouTube','@yourchannel'],['tiktok','TikTok','@yourname']].forEach(([k, label, ph]) => { %>
      <label><%= label %> <input name="social_<%= k %>" value="<%= l['social_' + k] || '' %>" placeholder="<%= ph %>"></label>
    <% }) %>
  </div>
</fieldset>
<fieldset class="span-2 area-checks"><legend>Practice areas</legend>
  <% areas.forEach(a => { %><label class="check"><input type="checkbox" name="areas" value="<%= a.id %>" <%= selected.has(a.slug) ? 'checked' : '' %>> <%= a.name %></label><% }) %>
</fieldset>
<div class="span-2 photo-field">
  <%- include('avatar', { l: { name: l.name || '?', photo: l.photo }, size: 'avatar-lg' }) %>
  <label>Photo <input type="file" name="photo" accept="image/jpeg,image/png,image/webp"></label>
  <% if (l.photo) { %><label class="check"><input type="checkbox" name="remove_photo"> Remove photo</label><% } %>
</div>
