<% if (areas.length) { %>
<section class="container section">
  <h2><%- e('home.areasTitle') %></h2>
  <div class="area-grid">
    <% areas.filter(a => a.depth === 0).forEach(a => { %>
      <a class="area-tile" href="/lawyers?area=<%= a.slug %>">
        <strong><%= a.name %></strong>
        <% if (a.description) { %><span class="small muted"><%= a.description %></span><% } %>
        <% if (a.children.length) { %><span class="tiny muted area-subs"><%= a.children.join(' · ') %></span><% } %>
        <span class="tiny"><%= a.group_count %> lawyer<%= a.group_count === 1 ? '' : 's' %></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>
