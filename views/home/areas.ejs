<% if (areas.length) { %>
<section class="container section">
  <h2><%- e('home.areasTitle') %></h2>
  <div class="area-grid">
    <% areas.forEach(a => { %>
      <a class="area-tile" href="/lawyers?area=<%= a.slug %>">
        <strong><%= a.name %></strong>
        <% if (a.description) { %><span class="small muted"><%= a.description %></span><% } %>
        <span class="tiny"><%= a.lawyer_count %> lawyer<%= a.lawyer_count === 1 ? '' : 's' %></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>
