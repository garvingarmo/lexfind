<%- include('partials/header') %>
<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1><%- e('hero_title') %></h1>
      <p class="lead"><%- e('hero_subtitle') %></p>
      <form class="search-bar" action="/lawyers" method="get" role="search">
        <label class="sr-only" for="hq"><%= t('search.keywords') %></label>
        <input id="hq" name="q" placeholder="<%= t('home.searchPlaceholder') %>">
        <label class="sr-only" for="harea"><%= t('search.area') %></label>
        <select id="harea" name="area">
          <option value=""><%= t('home.anyArea') %></option>
          <% areas.forEach(a => { %><option value="<%= a.slug %>"><%= a.label %></option><% }) %>
        </select>
        <label class="sr-only" for="hstate"><%= t('search.state') %></label>
        <select id="hstate" name="state">
          <option value=""><%= t('home.anyState') %></option>
          <% states.forEach(s => { %><option><%= s %></option><% }) %>
        </select>
        <button class="btn btn-primary"><%- e('home.searchButton') %></button>
      </form>
    </div>
    <form class="card ai-teaser" action="/assistant" method="get">
      <div class="ai-pill"><%- e('home.aiPill') %></div>
      <h2><%- e('home.aiTitle') %></h2>
      <p class="muted"><%- e('home.aiText') %></p>
      <label class="sr-only" for="aiq"><%= t('home.aiTitle') %></label>
      <textarea id="aiq" name="q" rows="4" placeholder="<%= t('home.aiPlaceholder') %>"></textarea>
      <button class="btn btn-accent btn-block"><%- e('home.aiButton') %></button>
      <p class="tiny muted"><%- e('home.aiNote') %></p>
    </form>
  </div>
</section>
<% sections.filter(s => s.visible).forEach(s => { %><%- include('home/' + s.id) %><% }) %>
<%- include('partials/footer') %>
