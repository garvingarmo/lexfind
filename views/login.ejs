<%- include('partials/header') %>
<section class="container narrow page-pad">
  <div class="card auth-card">
    <h1><%- e('login.title') %></h1>
    <p class="muted"><%- e('login.subtitle') %></p>
    <form method="post" action="/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label><%- e('login.email') %> <input name="email" type="email" required autocomplete="username"></label>
      <label><%- e('login.password') %> <input name="password" type="password" required autocomplete="current-password"></label>
      <button class="btn btn-primary btn-block"><%- e('login.button') %></button>
    </form>
    <p class="small"><a href="/forgot-password"><%- e('login.forgot') %></a></p>
    <p class="small"><%- e('login.new') %> <a href="/register"><%- e('login.create') %></a></p>
  </div>
</section>
<%- include('partials/footer') %>
