<%- include('partials/header') %>
<section class="container page-pad">
  <% if (lawyer.status !== 'active') { %><div class="flash flash-info">This listing is <strong><%= lawyer.status %></strong> and is not visible to the public yet.</div><% } %>
  <% if (isOwner) { %><div class="flash flash-info">This is your public profile. <a href="/dashboard/profile">Edit it</a>.</div><% } %>
  <div class="profile-layout">
    <div>
      <div class="card profile-head">
        <%- include('partials/avatar', { l: lawyer, size: 'avatar-lg' }) %>
        <div>
          <h1><%= lawyer.name %><% if (lawyer.verified) { %> <span class="verified" title="Verified listing">✓</span><% } %></h1>
          <div class="muted"><%= [lawyer.title, lawyer.firm].filter(Boolean).join(' · ') %></div>
          <div><%= [lawyer.city, lawyer.state].filter(Boolean).join(', ') %></div>
          <div class="tags"><% lawyer.areas.forEach(a => { %><a class="tag" href="/lawyers?area=<%= a.slug %>"><%= a.name %></a><% }) %></div>
        </div>
      </div>

      <div class="card">
        <h2>About</h2>
        <div class="prose"><%- bioHtml || '<p class="muted">No bio yet.</p>' %></div>
      </div>

      <div class="card">
        <h2>Details</h2>
        <dl class="details">
          <% [['Experience', lawyer.years_experience ? lawyer.years_experience + ' years' : null], ['Languages', lawyer.languages], ['Bar admissions', lawyer.bar_admissions],
              ['Education', lawyer.education], ['Fees', lawyer.fee_structure], ['Hourly rate', lawyer.hourly_rate],
              ['Free consultation', lawyer.free_consultation ? 'Yes' : 'No'], ['Office', [lawyer.address, lawyer.city, lawyer.state, lawyer.zip].filter(Boolean).join(', ')]].forEach(([k, v]) => { if (v) { %>
            <dt><%= k %></dt><dd><%= v %></dd>
          <% } }) %>
        </dl>
      </div>
    </div>

    <div class="sidebar">
      <div class="card contact-card" id="contact">
        <h2>Contact <%= lawyer.name.split(' ')[0] %></h2>
        <% if (lawyer.phone) { %><p><a class="btn btn-outline btn-block" href="tel:<%= lawyer.phone.replace(/[^\d+]/g, '') %>">☎ <%= lawyer.phone %></a></p><% } %>
        <% if (lawyer.website) { %><p><a class="btn btn-outline btn-block" href="<%= lawyer.website %>" target="_blank" rel="noopener nofollow">Visit website</a></p><% } %>
        <form method="post" action="/lawyers/<%= lawyer.slug %>/contact" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="source" value="<%= locals.query && query.from === 'ai' ? 'assistant' : 'profile' %>">
          <div class="hp" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"></div>
          <label>Your name <input name="name" required maxlength="120"></label>
          <label>Email <input name="email" type="email" required maxlength="200"></label>
          <label>Phone (optional) <input name="phone" maxlength="40"></label>
          <label>Briefly describe your matter <textarea name="message" rows="5" required maxlength="5000"></textarea></label>
          <button class="btn btn-primary btn-block">Send message</button>
          <p class="tiny muted">Sending a message does not create an attorney-client relationship. Avoid confidential details until you've spoken with the lawyer.</p>
        </form>
      </div>
      <%- include('partials/ad', { ad }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
