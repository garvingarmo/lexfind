<%- include('partials/header') %>
<section class="container page-pad">
  <% if (lawyer.status !== 'active') { %><div class="flash flash-info">This listing is <strong><%= lawyer.status %></strong> and is not visible to the public yet.</div><% } %>
  <% if (isOwner) { %><div class="flash flash-info">This is your public profile. <a href="/dashboard/profile">Edit it</a>.</div><% } %>
  <div class="profile-layout">
    <div>
      <div class="card profile-head">
        <%- include('partials/avatar', { l: lawyer, size: 'avatar-lg' }) %>
        <div>
          <h1><%= lawyer.name %><% if (lawyer.verified && pf.show_verified) { %> <span class="verified" title="Verified listing">✓</span><% } %></h1>
          <div class="muted"><%= [lawyer.title, lawyer.firm].filter(Boolean).join(' · ') %></div>
          <div><%= [lawyer.city, lawyer.state].filter(Boolean).join(', ') %></div>
          <div class="tags"><% lawyer.areas.forEach(a => { %><a class="tag" href="/lawyers?area=<%= a.slug %>"><%= a.name %></a><% }) %></div>
          <% if (pf.show_social && social.length) { %>
            <div class="social-links profile-social" aria-label="<%= t('profile.follow') %> <%= lawyer.name %>">
              <% social.forEach(n => { %><a href="<%= n.url %>" target="_blank" rel="noopener nofollow" aria-label="<%= n.label %>" title="<%= n.label %>"><%- socialIcon(n.key, 18) %></a><% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <div class="card">
        <h2><%- e('profile.about') %></h2>
        <div class="prose"><%- bioHtml || `<p class="muted">${e('profile.noBio')}</p>` %></div>
      </div>

      <div class="card">
        <h2><%- e('profile.details') %></h2>
        <dl class="details">
          <% [['profile.experience', pf.show_experience && lawyer.years_experience ? lawyer.years_experience + ' ' + t('profile.years') : null], ['profile.languages', pf.show_languages && lawyer.languages], ['profile.bar', pf.show_bar && lawyer.bar_admissions],
              ['profile.education', pf.show_education && lawyer.education],
              ['profile.office', pf.show_office && [lawyer.address, lawyer.city, lawyer.state, lawyer.zip].filter(Boolean).join(', ')]].forEach(([k, v]) => { if (v) { %>
            <dt><%- e(k) %></dt><dd><%= v %></dd>
          <% } }) %>
        </dl>
      </div>
    </div>

    <div class="sidebar">
      <% if (canRefer) { const d = referDraft; %>
      <details class="card refer-card" id="refer" <%= Object.keys(d).length ? 'open' : '' %>>
        <summary><span class="refer-title"><%- e('refer.title') %></span><span class="small muted"><%- e('refer.intro') %> <%= lawyer.name %>.</span></summary>
        <form method="post" action="/lawyers/<%= lawyer.slug %>/refer" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label><%- e('refer.clientName') %> <input name="client_name" required maxlength="120" value="<%= d.client_name || '' %>" autocomplete="off"></label>
          <label><%- e('refer.clientEmail') %> <input name="client_email" type="email" required maxlength="200" value="<%= d.client_email || '' %>" autocomplete="off"></label>
          <label><%- e('refer.clientPhone') %> <input name="client_phone" type="tel" required maxlength="40" value="<%= d.client_phone || '' %>" autocomplete="off"></label>
          <label><%- e('refer.matter') %> <span class="tiny muted">(<%- e('refer.optional') %>)</span>
            <textarea name="matter" rows="4" maxlength="3000" placeholder="<%= t('refer.matterPlaceholder') %>"><%= d.matter || '' %></textarea></label>
          <label class="check small"><input type="checkbox" name="consent" required <%= d.consent ? 'checked' : '' %>> <%- e('refer.consent') %></label>
          <button class="btn btn-accent btn-block"><%- e('refer.send') %></button>
          <p class="tiny muted"><%- e('refer.note') %></p>
        </form>
      </details>
      <% } %>
      <div class="card contact-card" id="contact">
        <h2><%- e('profile.contact') %> <%= lawyer.name.split(' ')[0] %></h2>
        <% if (pf.show_phone && lawyer.phone) { %><p><a class="btn btn-outline btn-block" href="tel:<%= lawyer.phone.replace(/[^\d+]/g, '') %>">☎ <%= lawyer.phone %></a></p><% } %>
        <% if (pf.show_mobile && lawyer.mobile) { %><p><a class="btn btn-outline btn-block" href="tel:<%= lawyer.mobile.replace(/[^\d+]/g, '') %>" aria-label="<%= t('profile.mobile') %> <%= lawyer.mobile %>">📱 <%= lawyer.mobile %></a></p><% } %>
        <% if (pf.show_email && lawyer.email) { %><p><a class="btn btn-outline btn-block" href="mailto:<%= lawyer.email %>">✉ <%- e('profile.emailButton') %> <%= lawyer.email %></a></p><% } %>
        <% if (pf.show_website && lawyer.website) { %><p><a class="btn btn-outline btn-block" href="<%= lawyer.website %>" target="_blank" rel="noopener nofollow"><%- e('profile.website') %></a></p><% } %>
        <% if (pf.show_contact_form) { %>
        <form method="post" action="/lawyers/<%= lawyer.slug %>/contact" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="source" value="<%= locals.query && query.from === 'ai' ? 'assistant' : 'profile' %>">
          <div class="hp" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"></div>
          <label><%- e('profile.yourName') %> <input name="name" required maxlength="120"></label>
          <label><%- e('profile.email') %> <input name="email" type="email" required maxlength="200"></label>
          <label><%- e('profile.phone') %> <input name="phone" maxlength="40"></label>
          <label><%- e('profile.message') %> <textarea name="message" rows="5" required maxlength="5000"></textarea></label>
          <button class="btn btn-primary btn-block"><%- e('profile.send') %></button>
          <p class="tiny muted"><%- e('profile.note') %></p>
        </form>
        <% } %>
      </div>
      <%- include('partials/ad', { ad }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
