<%- include('partials/header') %>
<section class="container narrow page-pad">
  <div class="card auth-card">
    <h1>Change password</h1>
    <form method="post" action="/account/password" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Current password <input name="current" type="password" required autocomplete="current-password"></label>
      <label>New password <input name="password" type="password" minlength="8" required autocomplete="new-password"></label>
      <label>Confirm new password <input name="password2" type="password" minlength="8" required autocomplete="new-password"></label>
      <button class="btn btn-primary btn-block">Update password</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
