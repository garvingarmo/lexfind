# Required in production
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000

# Claude API key — enables the AI lawyer-match agent and AI profile research.
# Without it the assistant falls back to keyword matching and research is disabled.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# DB_PATH=./data/directory.db
# Used by `npm run seed` for the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
