# Required in production
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000

# Claude API key — enables the AI lawyer-match agent and AI profile research.
# Without it the assistant falls back to keyword matching and research is disabled.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# DB_PATH=./data/directory.db
# Used by `npm run seed` for the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Public address used in invitation links (defaults to the address you're browsing from)
# PUBLIC_URL=https://chaldeanlaw.com

# Email sending for lawyer invitations (optional). Use the SMTP details of a
# mailbox you create in cPanel → Email Accounts → Connect Devices.
# SMTP_HOST=mail.chaldeanlaw.com
# SMTP_PORT=465
# SMTP_USER=hello@chaldeanlaw.com
# SMTP_PASS=
# MAIL_FROM="Chaldean Law <hello@chaldeanlaw.com>"

# Set to 1 while testing so search engines don't index the site; remove at launch.
# NOINDEX=1

# Where the database, uploads and import files are stored. Point this outside the
# code folder on hosts that redeploy the code (e.g. cPanel Web Apps).
# DATA_DIR=/home/USER/chaldeanlaw-data
# UPLOAD_DIR=   (defaults to DATA_DIR/uploads when DATA_DIR is set)

# Emergency admin access when locked out (no terminal needed): set this with ADMIN_EMAIL,
# restart, sign in with it, then REMOVE it and restart again.
# ADMIN_RESET_PASSWORD=
